---
import Layout from "../layouts/Layout.astro";
import Footer from "../components/Footer.astro";
import Navigation from "../components/Navigation.vue";
import { Image } from "astro:assets";
import dronesCover from "../assets/drones cover.jpg";
---

<Layout title="Logic Moon - Shop">
  <Navigation client:visible />

  <main class="bg-surface text-on-surface min-h-screen">
    <section class="max-w-4xl mx-auto px-6 py-20">
      <div class="text-center mb-16">
        <div class="w-1 h-20 bg-primary mx-auto mb-8"></div>
        <h1 class="text-6xl md:text-8xl font-light tracking-wider mb-6 text-on-surface">
          SHOP
        </h1>
        <p class="text-xl font-light text-on-surface/60 tracking-wide">
          Support Logic Moon
        </p>
        <div class="w-32 h-px bg-on-surface/20 mx-auto mt-8"></div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-px bg-on-surface/10 mb-16">
        <div class="bg-surface p-8">
          <p class="text-xs uppercase tracking-widest text-on-surface/40 mb-3">Sounds</p>
          <p class="text-on-surface/80 font-light leading-relaxed text-sm">
            Handcrafted raw guitar drones and textures — designed for ambient and cinematic productions.
          </p>
        </div>
        <div class="bg-surface p-8">
          <p class="text-xs uppercase tracking-widest text-on-surface/40 mb-3">Posters</p>
          <p class="text-on-surface/80 font-light leading-relaxed text-sm">
            Ultra high resolution print sets in uncompressed TIFF format. Art from the Logic Moon universe, ready to print.
          </p>
        </div>
        <div class="bg-surface p-8">
          <p class="text-xs uppercase tracking-widest text-on-surface/40 mb-3">Wallpapers</p>
          <p class="text-on-surface/80 font-light leading-relaxed text-sm">
            High resolution wallpapers up to 10,000px — direct from the cover art of Logic Moon releases.
          </p>
        </div>
      </div>

      <!-- Drones Vol. 1 -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-0 mb-16 items-stretch" data-animate>
        <div class="overflow-hidden aspect-square">
          <Image
            src={dronesCover}
            alt="Drones Vol. 1 Cover"
            densities={[1, 2]}
            class="w-full h-full object-cover"
          />
        </div>
        <div class="bg-surface-container p-10 flex flex-col gap-6">
          <div>
            <p class="text-xs uppercase tracking-widest text-on-surface/40 mb-3">Sounds</p>
            <h2 class="text-3xl font-light tracking-wide text-on-surface mb-4">Drones Vol. 1</h2>
            <p class="text-on-surface/70 font-light leading-relaxed text-sm">
              Carefully handcrafted raw Guitar Drones for your Ambient Productions in two different
              scales (A minor and E minor) as 24bit WAV samples.
            </p>
          </div>
          <ul class="flex flex-col gap-2">
            <li class="flex items-center gap-3 text-xs text-on-surface/50 uppercase tracking-widest">
              <span class="w-px h-3 bg-on-surface/30"></span>
              100% Royalty Free
            </li>
            <li class="flex items-center gap-3 text-xs text-on-surface/50 uppercase tracking-widest">
              <span class="w-px h-3 bg-on-surface/30"></span>
              24bit WAV · 20 Samples · 830 MB
            </li>
            <li class="flex items-center gap-3 text-xs text-on-surface/50 uppercase tracking-widest">
              <span class="w-px h-3 bg-on-surface/30"></span>
              A minor &amp; E minor
            </li>
          </ul>
          <div class="mt-auto flex flex-col gap-3">
            <iframe
              width="100%"
              height="166"
              scrolling="no"
              frameborder="no"
              allow="autoplay; encrypted-media"
              loading="lazy"
              title="Drones Vol.1 Demo"
              src="https://w.soundcloud.com/player/?url=https%3A//api.soundcloud.com/tracks/soundcloud%253Atracks%253A2167415187&color=%23363433&auto_play=false&hide_related=true&show_comments=false&show_user=false&show_reposts=false&show_teaser=false&visual=true"
            ></iframe>
            <a
              href="https://ko-fi.com/s/27381b17d7"
              target="_blank"
              rel="noopener noreferrer"
              class="text-center px-8 py-4 bg-primary text-on-primary uppercase tracking-widest text-xs font-light hover:brightness-110 transition-all duration-300">
              Buy on Ko-fi →
            </a>
          </div>
        </div>
      </div>

      <div class="text-center">
        <a
          href="https://ko-fi.com/logicmoonmusic/shop"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-block px-12 py-4 border border-on-surface/30 text-on-surface uppercase tracking-widest text-sm font-light hover:border-primary hover:text-primary transition-colors duration-300">
          Browse Shop
        </a>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
