---
import Layout from "../../layouts/Layout.astro";
import Navigation from "../../components/Navigation.vue";
import Footer from "../../components/Footer.astro";
import PlatformLinks from "../../components/PlatformLinks.astro";
import JsonLd from "../../components/JsonLd.astro";
import releases from "../../releases.js";

export function getStaticPaths() {
  return releases.map((release) => ({
    params: { slug: release.slug },
    props: { release },
  }));
}

interface Release {
  id: number;
  slug: string;
  cover: string;
  year: string;
  release_id?: string;
  title: string;
  text?: string;
  bandcamp?: string;
  spotify?: string;
  apple?: string;
  amazon?: string;
  soundcloud?: string;
  deezer?: string;
  beatport?: string;
}

const { release } = Astro.props as { release: Release };

const cleanTitle = release.title.trim();
const pageTitle = cleanTitle.toLowerCase().includes("logic moon")
  ? cleanTitle
  : `${cleanTitle} - Logic Moon`;

const description = release.text?.trim()
  ? release.text.trim().slice(0, 160)
  : `Listen to "${cleanTitle}" (${release.year}) by Logic Moon.`;

const PLATFORM_KEYS = ["bandcamp", "spotify", "apple", "amazon", "soundcloud", "deezer", "beatport"] as const;
const sameAs = PLATFORM_KEYS.map((k) => release[k]).filter(Boolean);

const schema = {
  "@context": "https://schema.org",
  "@type": "MusicAlbum",
  name: cleanTitle,
  byArtist: { "@type": "MusicGroup", name: "Logic Moon" },
  image: new URL(`/images/covers/${release.cover}`, Astro.site).toString(),
  datePublished: release.year,
  ...(sameAs.length ? { sameAs } : {}),
};

const others = releases
  .filter((r) => r.id !== release.id)
  .map((r) => ({ slug: r.slug, title: r.title, cover: r.cover, year: r.year }));

const hasBelowFold = Boolean(release.text || release.release_id);
---

<Layout title={pageTitle} description={description} image={`/images/covers/${release.cover}`}>
  <JsonLd schema={schema} />
  <Navigation client:visible />

  <main class="bg-surface text-on-surface">
    <section class="flex flex-col items-center justify-center gap-6 px-8 mx-auto max-w-lg text-center pt-[var(--header-height)] min-h-[calc(100dvh-var(--header-height))]">
      <a
        href="/discography"
        class="self-start inline-flex items-center gap-2 text-primary text-xs uppercase tracking-widest hover:gap-4 transition-all no-underline">
        <span>&larr;</span> Discography
      </a>

      <div class="w-[min(85vw,42dvh)] aspect-square bg-surface-container-lowest overflow-hidden">
        <img
          src={`/images/covers/${release.cover}`}
          alt={cleanTitle}
          class="w-full h-full object-cover"
        />
      </div>

      <div>
        <p class="text-xs uppercase tracking-widest text-on-surface/50 mb-2">{release.year}</p>
        <h1 class="text-[clamp(1.25rem,6vw,2rem)] font-bold uppercase tracking-tight leading-tight line-clamp-2">
          {cleanTitle}
        </h1>
      </div>

      <PlatformLinks links={release} />
    </section>

    {hasBelowFold && (
      <section class="px-8 md:px-16 py-20 max-w-2xl mx-auto text-center">
        {release.text && (
          <p class="text-on-surface-variant font-light leading-relaxed mb-10">{release.text}</p>
        )}
        {release.release_id && (
          <div class="bg-surface-container-lowest p-4">
            <iframe
              class="w-full border-0"
              style="height: 300px;"
              seamless
              title="Bandcamp Player"
              src={`https://bandcamp.com/EmbeddedPlayer/album=${release.release_id}/size=large/bgcol=141312/linkcol=e3c7a9/artwork=small/transparent=true/`}
            ></iframe>
          </div>
        )}
      </section>
    )}

    <section id="more-releases" class="px-8 md:px-16 pb-20 max-w-5xl mx-auto" hidden>
      <span class="text-[0.625rem] uppercase tracking-[0.2em] text-primary mb-6 block">More releases</span>
      <div id="more-releases-grid" class="grid grid-cols-2 md:grid-cols-4 gap-4 md:gap-6"></div>
    </section>
  </main>

  <Footer />
</Layout>

<script is:inline define:vars={{ others }}>
  const section = document.getElementById("more-releases");
  const grid = document.getElementById("more-releases-grid");
  const pool = others.slice();
  for (let i = pool.length - 1; i > 0; i--) {
    const j = Math.floor(Math.random() * (i + 1));
    [pool[i], pool[j]] = [pool[j], pool[i]];
  }
  pool.slice(0, 4).forEach((r) => {
    const a = document.createElement("a");
    a.href = "/discography/" + r.slug;
    a.className = "group block no-underline";
    a.setAttribute("aria-label", "View release " + r.title);

    const box = document.createElement("div");
    box.className = "aspect-square bg-surface-container-lowest overflow-hidden";
    const img = document.createElement("img");
    img.src = "/images/covers/" + r.cover;
    img.alt = r.title;
    img.loading = "lazy";
    img.className = "w-full h-full object-cover grayscale-50 group-hover:grayscale-0 transition-all duration-700";
    box.appendChild(img);

    const title = document.createElement("p");
    title.className = "font-bold text-sm text-on-surface leading-5 mt-3";
    title.textContent = r.title;
    const year = document.createElement("p");
    year.className = "text-xs opacity-50 uppercase tracking-widest mt-1 text-on-surface";
    year.textContent = r.year;

    a.append(box, title, year);
    grid.appendChild(a);
  });
  if (grid.children.length) section.hidden = false;
</script>
