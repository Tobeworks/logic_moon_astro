---
import Layout from "../layouts/Layout.astro";
import Navigation from "../components/Navigation.vue";
import Footer from "../components/Footer.astro";
import Contact from "../components/Contact.vue";
import press01 from "../assets/press-kit/logic moon_press01.jpg";
import press02 from "../assets/press-kit/logic moon_press02.jpg";
import press03 from "../assets/press-kit/logic moon_press03.jpg";
---

<Layout title="Press Kit - Logic Moon">
  <Navigation client:visible />

  <main class="min-h-screen bg-surface text-on-surface">
    <!-- Hero -->
    <section class="py-32 px-8 md:px-16 bg-surface-container-low">
      <div class="container mx-auto text-center">
        <span
          class="text-[0.625rem] uppercase tracking-[0.2em] text-primary mb-4 block"
          >Media Resources</span
        >
        <h1
          class="text-[clamp(3rem,7vw,6rem)] font-black tracking-tighter mb-6 text-on-surface uppercase">
          Press Kit
        </h1>
        <p
          class="text-on-surface/60 font-light leading-relaxed max-w-2xl mx-auto">
          Official assets and resources for media professionals, journalists,
          and publications. All materials available for editorial use.
        </p>
      </div>
    </section>

    <!-- Artists -->
    <section class="py-24 px-8 md:px-16 bg-surface">
      <div class="container mx-auto">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-px bg-on-surface/10">

          <!-- Logic Moon -->
          <div class="bg-surface p-10 flex flex-col">
            <span class="text-[0.625rem] uppercase tracking-[0.2em] text-primary mb-4 block">Artist</span>
            <h2 class="text-4xl font-bold tracking-tight uppercase mb-8">Logic Moon</h2>
            <p class="text-lg font-light text-on-surface/80 leading-relaxed mb-4">
              Logic Moon is the cinematic ambient project of Tobias Lorsbach, built around slow-moving soundscapes rooted in space, isolation, and introspection with a touch of arthouse cinema.
            </p>
            <p class="font-light text-on-surface/60 leading-relaxed mb-8">
              Influenced by Sakamoto, Aphex Twin, FSOL, and classic space ambient, the music sits at the intersection of drone, texture, and atmosphere. Made for deep listening, late nights, and quiet contemplation.
            </p>
            <div class="flex flex-wrap gap-2 mt-auto">
              {["Ambient", "Drone", "Cinematic", "Space", "Experimental"].map((tag) => (
                <span class="text-xs uppercase tracking-widest px-3 py-1 border border-on-surface/20 text-on-surface/50">{tag}</span>
              ))}
            </div>
          </div>

          <!-- Aethery Fields -->
          <div class="bg-surface-container p-10 flex flex-col">
            <span class="text-[0.625rem] uppercase tracking-[0.2em] text-primary mb-4 block">Artist</span>
            <h2 class="text-4xl font-bold tracking-tight uppercase mb-8">Aethery Fields</h2>
            <p class="text-lg font-light text-on-surface/80 leading-relaxed mb-4">
              Aethery Fields is the experimental and deeply introspective counterpart to Logic Moon — shaped by Japanese ambient, lo-fi aesthetics, cassette culture, and meditative drone.
            </p>
            <p class="font-light text-on-surface/60 leading-relaxed mb-8">
              Influenced by the quiet intensity of Chihei Hatakeyama and the textural minimalism of Taylor Deupree, Aethery Fields lives in the space between silence and sound — warm, worn, and unhurried. Music that breathes slowly and leaves room for the listener to exist within it.
            </p>
            <div class="flex flex-wrap gap-2 mt-auto">
              {["Asian Ambient", "Lo-Fi", "Cassette", "Drone", "Experimental", "Field Recording"].map((tag) => (
                <span class="text-xs uppercase tracking-widest px-3 py-1 border border-on-surface/20 text-on-surface/50">{tag}</span>
              ))}
            </div>
          </div>

        </div>
      </div>
    </section>

    <!-- Biography -->
    <section class="py-24 px-8 md:px-16 bg-surface-container-low">
      <div class="container mx-auto">
        <div class="mb-16">
          <span
            class="text-[0.625rem] uppercase tracking-[0.2em] text-primary mb-4 block"
            >Background</span
          >
          <h2 class="text-4xl md:text-5xl font-bold tracking-tight uppercase">
            Biography
          </h2>
        </div>
        <p class="text-on-surface/50 font-light text-sm mb-8 max-w-2xl">
          Ready-to-use bio copy for articles, liner notes, and event listings.
          Pick a length and copy it directly — no rewriting needed.
        </p>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-px bg-on-surface/10">
          <!-- Short -->
          <div class="bg-surface-container-low p-8 flex flex-col">
            <div class="flex items-center justify-between gap-4 mb-6">
              <span class="text-xs uppercase tracking-widest text-primary">Short · ~50 words</span>
              <button
                type="button"
                data-copy-target="bio-short"
                class="copy-bio-btn shrink-0 border cursor-pointer border-on-surface/20 text-on-surface/60 hover:text-on-surface hover:border-on-surface/40 px-4 py-2 text-xs uppercase tracking-widest transition-colors">
                Copy
              </button>
            </div>
            <p id="bio-short" class="font-light text-on-surface/70 leading-relaxed text-sm">Logic Moon is the cinematic ambient project of Mainz, Germany-based artist Tobias Lorsbach, built around slow-moving soundscapes rooted in space, isolation, and introspection. Active since 2011, his ambient, drone, and neoclassical-tinged music has been released on labels including Whitelabrecs, DRONARIVM, Ambientologist, Shimmering Moods, and his own imprint The Moon Records.</p>
          </div>

          <!-- Medium -->
          <div class="bg-surface-container-low p-8 flex flex-col">
            <div class="flex items-center justify-between gap-4 mb-6">
              <span class="text-xs uppercase tracking-widest text-primary">Medium · ~130 words</span>
              <button
                type="button"
                data-copy-target="bio-medium"
                class="copy-bio-btn shrink-0 border cursor-pointer border-on-surface/20 text-on-surface/60 hover:text-on-surface hover:border-on-surface/40 px-4 py-2 text-xs uppercase tracking-widest transition-colors">
                Copy
              </button>
            </div>
            <div id="bio-medium" class="space-y-4 font-light text-on-surface/70 leading-relaxed text-sm">
              <p>Tobias Lorsbach is a Mainz, Germany-based artist known as Logic Moon and Aethery Fields. His releases have appeared on internationally recognized labels such as Whitelabrecs, Archives, Archipel, DRONARIVM, Ambientologist, Shimmering Moods, Chitra, and his own The Moon Records imprint across both physical and digital formats.</p>
              <p>Tobias' musical background spans a wide range of genres — from performing guitar in a death metal band to a DJ career rooted in techno, and now establishing himself as a prominent voice in ambient music. He spent many years in the minimal techno scenes since the early 2000s, and while out on a field recording excursion, he fell upon the idea of layering ambient drones — the origin of his debut album as Logic Moon, "Herbst11".</p>
            </div>
          </div>

          <!-- Long -->
          <div class="bg-surface-container-low p-8 flex flex-col">
            <div class="flex items-center justify-between gap-4 mb-6">
              <span class="text-xs uppercase tracking-widest text-primary">Long · ~330 words</span>
              <button
                type="button"
                data-copy-target="bio-long"
                class="copy-bio-btn shrink-0 border cursor-pointer border-on-surface/20 text-on-surface/60 hover:text-on-surface hover:border-on-surface/40 px-4 py-2 text-xs uppercase tracking-widest transition-colors">
                Copy
              </button>
            </div>
            <div id="bio-long" class="space-y-4 font-light text-on-surface/70 leading-relaxed text-sm">
              <p>Tobias Lorsbach is a Mainz, Germany-based artist known as Logic Moon and Aethery Fields. His releases have appeared on internationally recognized labels such as Whitelabrecs, Archives, Archipel, DRONARIVM, Ambientologist, Shimmering Moods, Chitra, and his own The Moon Records imprint across both physical and digital formats.</p>
              <p>He spent many years in the minimal techno scenes since the early 2000s, and while out on a field recording excursion, he fell upon the idea of layering some ambient drones. From here, his debut album as Logic Moon was born — "Herbst11".</p>
              <p>Tobias' musical background spans a wide range of genres — from performing guitar in a death metal band to a DJ career rooted in techno, and now establishing himself as a prominent voice in ambient music. His varied experiences are clearly evident in his acclaimed albums.</p>
              <p>Logic Moon has also become well known for his mastering and post-production work for internationally recognized labels like Whitelabrecs, DRONARIVM, Archives, and artists all over the globe.</p>
              <p>Musically, Logic Moon merges ambient, drone, and neoclassical influences into sound-painterly, cinematic soundscapes that combine electronic and acoustic elements. His pieces often begin with guitar or piano motifs, overlaid with flowing synthesizer drones, strings, and field recordings.</p>
              <p>Logic Moon frequently collaborates with other artists and labels. His newest release, "Musica Universalis" (2026, Ambient Cat), is a deep drone and space ambient collaboration with Piscean Daydreams (JJ Rogalski), conceived as the soundtrack to an imagined science-fiction film in the vein of Blade Runner. With composer Sven Laux, he released "The Unavoidable Death of Loneliness" (2022, Ambientologist) and "The Quiet Companion" (2023, Shimmering Moods). With Swedish cellist Henrik Meierkord, he released "Inseln" (2022) and the mini albums "Ewiger Wald" and "Ewiger Wald Addendum" (2024), blending electronic drones with cello into neoclassical ambient studies. With producer Scarless Arms, he released the six-track "Moon Scars" EP (2023) in a cinematic ambient style.</p>
              <p>Active since 2011 and based in Mainz, Germany, Logic Moon continues to release music internationally on labels including Whitelabrecs, DRONARIVM, Ambientologist, Shimmering Moods, Archipel, Archives, and his own imprint The Moon Records.</p>
            </div>
          </div>
        </div>
        <div class="flex justify-end mt-8">
          <a
            href="/logic-moon-bio"
            class="bg-gradient-to-br from-primary to-primary-container text-on-primary px-10 py-5 text-sm font-bold uppercase tracking-widest hover:brightness-110 transition-all no-underline text-center">
            Read Full Biography →
          </a>
        </div>
      </div>
    </section>

    <!-- Facts -->
    <section class="px-8 md:px-16 bg-surface">
      <div class="container mx-auto">
        <div class="grid grid-cols-2 md:grid-cols-4 gap-px bg-on-surface/10">
          <div class="bg-surface p-8">
            <p
              class="text-xs uppercase tracking-widest text-on-surface/40 mb-3">
              Based in
            </p>
            <p class="text-lg font-light text-on-surface">Mainz, Germany</p>
          </div>
          <div class="bg-surface p-8">
            <p
              class="text-xs uppercase tracking-widest text-on-surface/40 mb-3">
              Active since
            </p>
            <p class="text-lg font-light text-on-surface">2011</p>
          </div>
          <div class="bg-surface p-8">
            <p
              class="text-xs uppercase tracking-widest text-on-surface/40 mb-3">
              Label
            </p>
            <a href="https://the-moon-records.de" target="_blank" rel="noopener noreferrer" class="text-lg font-light text-primary hover:underline">The Moon Records</a>
          </div>
          <div class="bg-surface p-8">
            <p
              class="text-xs uppercase tracking-widest text-on-surface/40 mb-3">
              Genres
            </p>
            <p class="text-lg font-light text-on-surface">
              Ambient · Drone · Cinematic
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Press Photos — Logic Moon -->
    <section class="py-24 px-8 md:px-16 bg-surface-container-low">
      <div class="container mx-auto">
        <div class="mb-16 flex items-end justify-between">
          <div>
            <span
              class="text-[0.625rem] uppercase tracking-[0.2em] text-primary mb-4 block"
              >Imagery</span
            >
            <h2 class="text-4xl md:text-5xl font-bold tracking-tight uppercase">
              Press Photos
            </h2>
            <p class="text-on-surface/40 font-light mt-4 text-sm">
              High-resolution images for editorial use. Credit: 
              Tobias Lorsbach
            </p>
          </div>
          <button
            id="download-all"
            class="shrink-0 border cursor-pointer border-on-surface/20 text-on-surface/60 hover:text-on-surface hover:border-on-surface/40 px-6 py-3 text-xs uppercase tracking-widest transition-colors flex items-center gap-2">
            Download All <span>↓</span>
          </button>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-px bg-on-surface/10">
          <div class="bg-surface-container-low group">
            <div class="aspect-square overflow-hidden">
              <img
                src={press01.src}
                alt="Logic Moon — Press Photo 01"
                class="w-full h-full object-cover grayscale-[20%] group-hover:scale-105 transition-transform duration-500"
              />
            </div>
            <div class="p-6 flex items-center justify-between">
              <div>
                <p class="text-sm text-on-surface font-medium">
                  Press Photo 01
                </p>
                <p class="text-xs text-on-surface/40 mt-1">
                  JPG · High Resolution
                </p>
              </div>
              <a
                href={press01.src}
                download="logic-moon-press01.jpg"
                class="text-xs uppercase tracking-widest text-primary hover:text-on-surface transition-colors flex items-center gap-2">
                Download <span>↓</span>
              </a>
            </div>
          </div>
          <div class="bg-surface-container-low group">
            <div class="aspect-square overflow-hidden">
              <img
                src={press02.src}
                alt="Logic Moon — Press Photo 02"
                class="w-full h-full object-cover grayscale-[20%] group-hover:scale-105 transition-transform duration-500"
              />
            </div>
            <div class="p-6 flex items-center justify-between">
              <div>
                <p class="text-sm text-on-surface font-medium">
                  Press Photo 02
                </p>
                <p class="text-xs text-on-surface/40 mt-1">
                  JPG · High Resolution
                </p>
              </div>
              <a
                href={press02.src}
                download="logic-moon-press02.jpg"
                class="text-xs uppercase tracking-widest text-primary hover:text-on-surface transition-colors flex items-center gap-2">
                Download <span>↓</span>
              </a>
            </div>
          </div>
          <div class="bg-surface-container-low group">
            <div class="aspect-square overflow-hidden">
              <img
                src={press03.src}
                alt="Logic Moon — Press Photo 03"
                class="w-full h-full object-cover grayscale-[20%] group-hover:scale-105 transition-transform duration-500"
              />
            </div>
            <div class="p-6 flex items-center justify-between">
              <div>
                <p class="text-sm text-on-surface font-medium">
                  Press Photo 03
                </p>
                <p class="text-xs text-on-surface/40 mt-1">
                  JPG · High Resolution
                </p>
              </div>
              <a
                href={press03.src}
                download="logic-moon-press03.jpg"
                class="text-xs uppercase tracking-widest text-primary hover:text-on-surface transition-colors flex items-center gap-2">
                Download <span>↓</span>
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Music & Releases -->
    <section class="py-24 px-8 md:px-16 bg-surface-container-low">
      <div class="container mx-auto">
        <div class="mb-16">
          <span
            class="text-[0.625rem] uppercase tracking-[0.2em] text-primary mb-4 block"
            >Audio</span
          >
          <h2 class="text-4xl md:text-5xl font-bold tracking-tight uppercase">
            Music & Releases
          </h2>
        </div>
        <div
          class="grid grid-cols-2 md:grid-cols-4 gap-px bg-on-surface/10 mb-8">
          <a
            href="https://logicmoon.bandcamp.com/"
            target="_blank"
            rel="noopener noreferrer"
            class="bg-surface-container-low p-8 hover:bg-surface-container transition-colors group">
            <p class="text-xs uppercase tracking-widest text-primary mb-2">
              Bandcamp
            </p>
            <p
              class="text-sm font-light text-on-surface/60 group-hover:text-on-surface/80 transition-colors">
              Full discography
            </p>
          </a>
          <a
            href="https://open.spotify.com/artist/3cqJW0hZR5efv5YWJKVMw8"
            target="_blank"
            rel="noopener noreferrer"
            class="bg-surface-container-low p-8 hover:bg-surface-container transition-colors group">
            <p class="text-xs uppercase tracking-widest text-primary mb-2">
              Spotify
            </p>
            <p
              class="text-sm font-light text-on-surface/60 group-hover:text-on-surface/80 transition-colors">
              Streaming & playlists
            </p>
          </a>
          <a
            href="https://www.youtube.com/@LogicMoonMusic"
            target="_blank"
            rel="noopener noreferrer"
            class="bg-surface-container-low p-8 hover:bg-surface-container transition-colors group">
            <p class="text-xs uppercase tracking-widest text-primary mb-2">
              YouTube
            </p>
            <p
              class="text-sm font-light text-on-surface/60 group-hover:text-on-surface/80 transition-colors">
              Music & visuals
            </p>
          </a>
          <a
            href="https://soundcloud.com/logic-moon"
            target="_blank"
            rel="noopener noreferrer"
            class="bg-surface-container-low p-8 hover:bg-surface-container transition-colors group">
            <p class="text-xs uppercase tracking-widests text-primary mb-2">
              SoundCloud
            </p>
            <p
              class="text-sm font-light text-on-surface/60 group-hover:text-on-surface/80 transition-colors">
              Exclusive tracks
            </p>
          </a>
        </div>
        <div
          class="border-t border-on-surface/10 pt-8 flex items-center justify-between">
          <p class="text-on-surface/50 font-light text-sm">
            High-quality audio files available upon request for press review.
          </p>
          <a
            href="/discography"
            class="inline-flex items-center gap-2 text-primary text-xs uppercase tracking-widest hover:gap-4 transition-all">
