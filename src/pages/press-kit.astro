          </h2>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-px bg-on-surface/10">
          <div class="bg-surface p-10 space-y-8">
            <div>
              <p
                class="text-xs uppercase tracking-widest text-on-surface/40 mb-2">
                Management
              </p>
              <p class="text-on-surface font-light">Tobias Lorsbach</p>
              <a
                href="mailto:hello@tobeworks.de"
                class="text-primary hover:underline font-light"
                >tobias@logic-moon.de</a
              >
            </div>
            <div>
              <p
                class="text-xs uppercase tracking-widest text-on-surface/40 mb-2">
                Location
              </p>
              <p class="text-on-surface font-light">Mainz, Germany</p>
            </div>
            <div>
              <p
                class="text-xs uppercase tracking-widest text-on-surface/40 mb-3">
                Social Media
              </p>
              <div class="flex flex-wrap gap-4">
                <a
                  href="https://www.instagram.com/logicmoonmusic/"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-primary hover:underline font-light text-sm"
                  >Instagram</a
                >
                <a
                  href="https://logicmoon.bandcamp.com/"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-primary hover:underline font-light text-sm"
                  >Bandcamp</a
                >
                <a
                  href="https://open.spotify.com/artist/3cqJW0hZR5efv5YWJKVMw8"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-primary hover:underline font-light text-sm"
                  >Spotify</a
                >
                <a
                  href="https://www.youtube.com/@LogicMoonMusic"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-primary hover:underline font-light text-sm"
                  >YouTube</a
                >
              </div>
            </div>
          </div>
          <div class="bg-surface p-10 space-y-6">
            <p
              class="text-xs uppercase tracking-widest text-on-surface/40 mb-4">
              Usage Guidelines
            </p>
            <p class="font-light text-on-surface/60 leading-relaxed text-sm">
              All assets are available for use by media professionals,
              journalists, and publications for editorial purposes. Please
              credit <strong class="text-on-surface font-medium"
                >Tobias Lorsbach (Tobworks)</strong
              > when using these materials.
            </p>
            <p class="font-light text-on-surface/60 leading-relaxed text-sm">
              All music, images, and branding materials are © Logic Moon /
              Tobias Lorsbach. All rights reserved. For commercial use beyond
              editorial coverage, please contact for licensing.
            </p>
            <a
              href="/licensing"
              class="inline-flex items-center gap-2 text-primary text-xs uppercase tracking-widest hover:gap-4 transition-all block mt-4">
              Licensing Information <span>→</span>
            </a>
          </div>
        </div>
      </div>
    </section>

    <Contact client:visible />
  </main>

  <Footer />
</Layout>

<script
  define:vars={{
    press01src: press01.src,
    press02src: press02.src,
    press03src: press03.src,
  }}
>
  document.getElementById("download-all")?.addEventListener("click", async () => {
    const btn = document.getElementById("download-all");
    if (btn) btn.textContent = "Preparing ZIP…";

    const JSZip = (await import("https://cdn.jsdelivr.net/npm/jszip@3.10.1/+esm")).default;
    const zip = new JSZip();

    const files = [
      { src: press01src, name: "logic-moon-press01.jpg" },
      { src: press02src, name: "logic-moon-press02.jpg" },
      { src: press03src, name: "logic-moon-press03.jpg" },
    ];

    await Promise.all(
      files.map(async ({ src, name }) => {
        const res = await fetch(src);
        const blob = await res.blob();
        zip.file(name, blob);
      })
    );

    const zipBlob = await zip.generateAsync({ type: "blob" });
    const url = URL.createObjectURL(zipBlob);
    const a = document.createElement("a");
    a.href = url;
    a.download = "logic-moon-press-photos.zip";
    document.body.appendChild(a);
    a.click();
    document.body.removeChild(a);
    URL.revokeObjectURL(url);

    if (btn) btn.textContent = "Download All ↓";
  });

  document.querySelectorAll(".copy-bio-btn").forEach((btn) => {
    btn.addEventListener("click", async () => {
      const target = document.getElementById(btn.dataset.copyTarget);
      if (!target) return;
      await navigator.clipboard.writeText(target.innerText.trim());
      const original = btn.textContent;
      btn.textContent = "Copied!";
      setTimeout(() => { btn.textContent = original; }, 1500);
    });
  });
</script>
