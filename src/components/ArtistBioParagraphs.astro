---
/**
 * ArtistBioParagraphs
 * Renders the canonical bio paragraphs for Tobias Lorsbach / Logic Moon.
 * Edit this file to update the bio everywhere it appears.
 *
 * Props:
 *   class: optional extra classes on the wrapper div
 *   highlight: "span" (default) | "link", how to render "The Moon Records"
 */

interface Props {
  class?: string;
  highlight?: "span" | "link";
}

const { class: className = "", highlight = "span" } = Astro.props;

const tmr =
  highlight === "link"
    ? `<a href="https://the-moon-records.de" target="_blank" rel="noopener noreferrer" class="text-primary hover:underline">The Moon Records</a>`
    : `<span class="font-medium text-on-surface">The Moon Records</span>`;
---

<div class={className}>
  <p set:html={`Tobias Lorsbach is a Mainz, Germany-based artist known as <span class="font-medium text-on-surface">Logic Moon</span> and <span class="font-medium text-on-surface">Aethery Fields</span>. His releases have appeared on internationally recognized labels such as Whitelabrecs, Archives, Archipel, DRONARIVM, Ambientologist, Shimmering Moods, Chitra, Siril Records, Respite Records, and his own ${tmr} imprint across both physical and digital formats.`}></p>

  <p>He spent many years in the minimal techno scenes since the early 2000s, and whilst out on a field recording excursion, he fell upon the idea of layering some ambient drones. From here, his debut album as Logic Moon was born: "Herbst11".</p>

  <p>Tobias' musical background spans a widescreen of genres, from performing guitar in a death metal band to a DJ career rooted in techno, and now establishing himself as a prominent voice in ambient music. His varied experiences are clearly evident in his acclaimed albums.</p>

  <p>Logic Moon has also become well known for his mastering and post-production work for internationally recognized labels like Whitelabrecs, DRONARIVM, Archives, and artists all over the globe.</p>
</div>
