---
import { Picture } from "astro:assets";
import portrait from "../assets/img/Logic-Woods-3.webp";
import ArtistBioParagraphs from "./ArtistBioParagraphs.astro";
---

<section class="bg-surface-container-low py-12 px-5 md:py-32 md:px-16" id="about">
  <div class="container mx-auto">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-8 md:gap-16 items-start">
      <!-- Text Content (5 cols) -->
      <div class="md:col-span-5">
        <span class="text-[0.625rem] uppercase tracking-[0.2em] text-primary mb-4 md:mb-8 block" data-animate>
          THE ARCHITECT
        </span>
        <h2 class="text-3xl md:text-6xl font-bold mb-5 md:mb-12 tracking-tight" data-animate>
          TOBIAS LORSBACH
        </h2>
        <div class="group space-y-6 text-on-surface-variant font-light leading-relaxed" data-animate data-bio>
          <ArtistBioParagraphs class="space-y-6" collapsible />

          <p class="hidden md:block group-data-[open]:block">
            Recent collaborative projects include works with Swedish cellist Henrik Meierkord on albums such as "Inseln" (2022) and "Ewiger Wald" (2024), as well as partnerships with artists like Sven Laux and Scarless Arms.
          </p>

          <button type="button" class="md:hidden min-h-11 text-primary text-xs uppercase tracking-[0.2em] cursor-pointer" aria-expanded="false" data-bio-toggle>
            Read more
          </button>

          <div class="flex gap-4 mt-2 md:mt-8">
            <a href="/logic-moon-bio" class="text-primary text-xs uppercase tracking-[0.2em] hover:text-primary-container transition-colors no-underline">
              BIOGRAPHICAL INFO →
            </a>
          </div>
        </div>
      </div>

      <!-- Portrait (7 cols) -->
      <div class="order-first md:order-none md:col-span-7 flex justify-end" data-animate>
        <div class="w-full max-w-2xl bg-surface-container-lowest">
          <Picture
            src={portrait}
            alt="Tobias Lorsbach portrait"
            widths={[400, 800, 1200]}
            sizes="(min-width: 768px) 50vw, 100vw"
            formats={["avif", "webp"]}
            class="w-full grayscale-[50%] hover:grayscale-0 transition-all duration-700 aspect-[4/3] object-[50%_40%] md:aspect-[4/5] md:object-center object-cover"
            loading="lazy"
          />
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  const group = document.querySelector<HTMLElement>("[data-bio]");
  const toggle = document.querySelector<HTMLButtonElement>("[data-bio-toggle]");
  toggle?.addEventListener("click", () => {
    const open = group?.toggleAttribute("data-open");
    toggle.setAttribute("aria-expanded", String(Boolean(open)));
    toggle.textContent = open ? "Show less" : "Read more";
  });
</script>
