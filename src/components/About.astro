---
import { Picture } from "astro:assets";
import portrait from "../assets/img/Logic-Woods-3.webp";
import ArtistBioParagraphs from "./ArtistBioParagraphs.astro";
---

<section class="bg-surface-container-low py-32 px-8 md:px-16" id="about">
  <div class="container mx-auto">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-16 items-start">
      <!-- Text Content (5 cols) -->
      <div class="md:col-span-5">
        <span class="text-[10px] uppercase tracking-[0.2em] text-primary mb-8 block" data-aos="fade-up">
          THE ARCHITECT
        </span>
        <h2 class="text-4xl md:text-6xl font-bold mb-12 tracking-tight" data-aos="fade-up">
          TOBIAS LORSBACH
        </h2>
        <div class="space-y-6 text-on-surface-variant font-light leading-relaxed" data-aos="fade-up">
          <ArtistBioParagraphs class="space-y-6" />

          <p>
            Recent collaborative projects include works with Swedish cellist Henrik Meierkord on albums such as "Inseln" (2022) and "Ewiger Wald" (2024), as well as partnerships with artists like Sven Laux and Scarless Arms.
          </p>

          <div class="flex gap-4 mt-8">
            <a href="/logic-moon-bio" class="text-primary text-xs uppercase tracking-[0.2em] hover:text-primary-container transition-colors no-underline">
              BIOGRAPHICAL INFO →
            </a>
          </div>
        </div>
      </div>

      <!-- Portrait (7 cols) -->
      <div class="md:col-span-7 flex justify-end" data-aos="fade-up">
        <div class="w-full max-w-2xl bg-surface-container-lowest">
          <Picture
            src={portrait}
            alt="Tobias Lorsbach portrait"
            widths={[400, 800, 1200]}
            sizes="(min-width: 768px) 50vw, 100vw"
            formats={["avif", "webp"]}
            class="w-full grayscale-[50%] hover:grayscale-0 transition-all duration-700 aspect-[4/5] object-cover"
            loading="lazy"
          />
        </div>
      </div>
    </div>
  </div>
</section>
